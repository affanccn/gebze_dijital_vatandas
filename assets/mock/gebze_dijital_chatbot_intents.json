{
  "project": "Gebze Dijital",
  "version": "1.0",
  "language": "tr-TR",
  "purpose": "API veya ücretli yapay zeka kullanmadan, yerel intent/keyword eşleştirme ile kullanıcı sorularını uygulama içindeki sayfalara veya kontrollü hazır cevaplara yönlendirmek.",
  "matching": {
    "strategy": "hybrid_local_intent",
    "normalization": [
      "lowercase",
      "turkish_character_normalization",
      "punctuation_removal",
      "whitespace_normalization",
      "phrase_matching",
      "keyword_matching",
      "basic_turkish_suffix_variation"
    ],
    "weights": {
      "exact_phrase": 5,
      "keyword": 2,
      "multiple_keyword_bonus": 1,
      "strong_topic_match": 3
    },
    "confidence_policy": {
      "high": "direct_action",
      "medium": "ask_confirmation_or_show_choices",
      "low": "unknown"
    }
  },
